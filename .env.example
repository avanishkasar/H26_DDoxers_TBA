# Copy to .env (never commit .env). Cloud/paid APIs are banned at the event: local models only.

# --- Backend ---
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Ollama server. Native install on Windows: http://localhost:11434
# From inside Docker to a host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Verify the exact tag with `ollama list` after pulling.
OLLAMA_MODEL=gemma4
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=4

# --- Frontend (Vite dev server) ---
VITE_API_PROXY_TARGET=http://localhost:8000
# Leave empty to use the dev proxy / nginx; set only to call the API cross-origin.
VITE_API_BASE_URL=

# --- Docker compose only ---
# Where the backend container reaches Ollama. Use http://ollama:11434 with `--profile ollama`.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
